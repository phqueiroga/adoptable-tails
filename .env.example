# Never commit real secret values.

# Required: powers the five Claude agents. Falls back to a deterministic
# MockLanguageModel (no API calls) when omitted, for local development.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required: grounds the named attraction with Google Places (the sole
# external API the Researcher uses).
GOOGLE_MAPS_API_KEY=

# Required: stores run state (evidence, outputs, usage) between pipeline steps.
BLOB_READ_WRITE_TOKEN=

# Optional: override the default per-run safety budget (9 calls, $0.20).
MAX_CLAUDE_CALLS_PER_RUN=
MAX_CLAUDE_COST_PER_RUN_USD=
